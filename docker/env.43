# Moodle 4.3.11+ (stable403), PHP 8.2, web docroot = Moodle root. Dev defaults, no secrets.
# Tarball SHA-256 verified 2026-11-02 against moodle-latest-403.tgz; update both on a bump.
COMPOSE_PROJECT_NAME=vektra-moodle43
PHP_VERSION=8.2
MOODLE_DOCROOT=/var/www/html
MOODLE_TGZ_URL=https://download.moodle.org/download.php/direct/stable403/moodle-latest-403.tgz
MOODLE_TGZ_SHA256=ea9d079f8db7620215f371de922d9b6408108f97c075aa13115a49619fabf225
MOODLE_PORT=8080
MARIADB_PORT=10406
MOODLE_URL=http://localhost:8080
ADMIN_USER=admin
ADMIN_PASS=Admin123!
ADMIN_EMAIL=admin@test.local
DB_NAME=moodle
DB_USER=moodleuser
DB_PASS=moodlepass
DB_ROOT_PASS=moodle_root
