# n8n
N8N_PORT=5678
N8N_ENCRYPTION_KEY=change-me-to-a-random-string
TIMEZONE=Europe/Rome

# Moodle Web Services
MOODLE_URL=http://vektra-moodle
MOODLE_WS_TOKEN=your-moodle-ws-token

# Vektra API
VEKTRA_API_URL=http://vektra-stack-vektra-1:8000
VEKTRA_API_KEY=your-vektra-ingest-api-key

# External Docker networks. Override when your vektra-stack or vektra-moodle
# compose files use a non-default project name (check `docker network ls`).
# VEKTRA_STACK_NETWORK=vektra-stack_default
# MOODLE_NETWORK=docker_default

# Teacher opt-out: a module whose TITLE contains this tag is excluded from the
# index, and removed from it on the next run if it was already ingested.
# Matched case-insensitively anywhere in the title. Set to an empty string to
# disable the feature. Note it is the module title, not the file name.
INGEST_OPT_OUT_TAG=[no-ai]

# Polling — quoted because some dotenv parsers split on whitespace.
INGEST_CRON="*/5 * * * *"

# Safety: skip mass deletions when Moodle returns an empty file list for a
# course that previously had >= DELETION_SAFETY_THRESHOLD documents in state.
# Default 3. Set to 0 to disable the safety net (deletions always run as
# computed by the diff). Useful to lower for very small test courses.
DELETION_SAFETY_THRESHOLD=3

# yt-dlp-api (transcript extraction for YouTube course material)
# Shared between the n8n workflow and the service.
# Use only [A-Za-z0-9_-]. The service reads this as a JSON list built by
# docker-compose interpolation, which cannot escape: a double quote or a
# backslash in the key yields invalid JSON and the container exits with
# `SettingsError: error parsing value for field "api_keys"`.
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
YTDLP_API_KEY=change-me-to-a-random-string
# Override only if you run the service outside this compose stack.
# YTDLP_API_URL=http://ytdlp-api:8000
# Caption language requested from YouTube.
YTDLP_TRANSCRIPT_LANG=it
